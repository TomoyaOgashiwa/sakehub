{
  "name": "sakehub",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:mobile": "pnpm --filter @sakehub/mobile dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "format": "prettier --write .",
    "supabase:seed": "supabase db query --local --file supabase/seed.sql"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^9.39.1",
    "lightningcss": "1.33.0",
    "globals": "^17.7.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.5"
  },
  "packageManager": "pnpm@11.0.4",
  "pnpm": {
    "overrides": {
      "lightningcss": "1.33.0"
    }
  }
}
