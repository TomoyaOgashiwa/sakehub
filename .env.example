# =============================================================================
# SakeHub ルート .env の雛形（single source of truth）
# 使い方: cp .env.example .env のあと、`supabase status` の値でキーを埋める
# =============================================================================

# --- Web (Next.js) ---
# apps/web の Supabase クライアント / SSR / proxy が参照。
# `supabase status` → Project URL / Publishable（sb_publishable_...）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# --- Mobile (Expo) ---
# クライアントバンドルに埋め込まれる。Service Role は絶対に入れない。
# Publishable は Web の ANON_KEY と同じ値でよい。
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
EXPO_PUBLIC_API_URL=http://localhost:8080

# --- Go API ---
# apps/api: リッスンポート / Postgres / Auth JWKS 取得先
API_PORT=8080
# Web の Server Actions 等が Go API を叩くときのベース URL
API_URL=http://localhost:8080
# ローカル Postgres は SSL なし。末尾の ?sslmode=disable 必須
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?sslmode=disable
SUPABASE_URL=http://127.0.0.1:54321

# --- サーバー専用（クライアントに出さない） ---
# `supabase status -o env` → SERVICE_ROLE_KEY（eyJ... の JWT）
# ※ 表形式 status の Secret（sb_secret_...）や S3 Secret Key ではない
#   sb_secret_ だと Storage upload が Invalid Compact JWS で落ちる
# 用途: pnpm seed:images:upload など service_role が必要な処理
# seed:images:upload はデフォルトで https://*.supabase.co のみ許可
# （ローカル URL のままだと拒否。試験時のみ --allow-local）
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- AI（任意。draft / カタログ画像生成時のみ） ---
# OPENAI_API_KEY=
# drink/cocktail draft のモデル上書き（省略時 gpt-4o-mini）
# OPENAI_MODEL=gpt-4o-mini
# catalog image generate のモデル上書き（省略時 gpt-image-1.5）
# OPENAI_IMAGE_MODEL=gpt-image-1.5
