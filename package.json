{
  "name": "sakehub",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:mobile": "pnpm --filter @sakehub/mobile dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "format": "prettier --write .",
    "supabase:seed": "supabase db query --local --file supabase/seeds/official_cocktails.sql && supabase db query --local --file supabase/seed.sql",
    "seed:cocktails:validate": "pnpm --filter @sakehub/cocktail-seed validate",
    "seed:cocktails:build": "pnpm --filter @sakehub/cocktail-seed build",
    "seed:cocktails:draft": "pnpm --filter @sakehub/cocktail-seed draft"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.39.1",
    "lightningcss": "1.33.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.8"
  },
  "packageManager": "pnpm@11.0.4",
  "pnpm": {
    "overrides": {
      "lightningcss": "1.33.0"
    }
  }
}
